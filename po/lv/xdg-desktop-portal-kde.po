msgid "Screen Sharing Not Available"
msgstr "Ekrāna kopīgošana nav pieejama"

#: src/screencast.cpp:153
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The application <application>%1</application> tried to start a screen "
"sharing session but screen sharing is not available on this system. Please "
"ensure you are running a Wayland session with a compatible window manager "
"such as KWin."
msgstr ""
"Lietojumprogramma „<application>%1</application>“ mēģināja uzsākt ekrāna "
"kopīgošanas sesiju, tomēr ekrāna kopīgošana šajā sistēmā nav pieejama. "
"Pārliecinieties, ka darbināt „Wayland“ sesiju ar saderīgu logu pārvaldnieku, "
"piemēram, „KWin“."

#: src/screencast.cpp:157
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The application <application>%1</application> tried to start a screen "
"sharing session but screen sharing is not available in X11 sessions. Please "
"switch to a Wayland session and try again."
msgstr ""
"Lietojumprogramma „<application>%1</application>“ mēģināja palaist ekrāna "
"kopīgošanas sesiju, tomēr X11 neatbalsta ekrāna kopīgošanu. Pārslēdzieties "
"uz „Wayland“ sesiju un mēģiniet vēlreiz."

