#: src/screencast.cpp:154
#, kde-format
msgctxt "@title:window"
msgid "Screen Sharing Not Available"
msgstr "Sdílení obrazovky není dostupné"

#: src/screencast.cpp:156
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The application <application>%1</application> tried to start a screen "
"sharing session but screen sharing is not available on this system. Please "
"ensure you are running a Wayland session with a compatible window manager "
"such as KWin."
msgstr ""
"Aplikace <application>%1</application> se pokusila spustit sezení sdílené "
"obrazovky, ale sdílení obrazovky není na tomto systému k dispozici. Ujistěte "
"se, že používáte sezení Wayland s kompatibilním správcem oken, jako je KWin."

#: src/screencast.cpp:160
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The application <application>%1</application> tried to start a screen "
"sharing session but screen sharing is not available in X11 sessions. Please "
"switch to a Wayland session and try again."
msgstr ""
"Aplikace <application>%1</application> se pokusila spustit sezení sdílené "
"obrazovky, ale sdílení obrazovky není v sezeních X11 k dispozici. Přepněte "
"se prosím do sezení Wayland a zkuste to znovu."

